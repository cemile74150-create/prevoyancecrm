# Sauvegarde professionnelle CRM — ne jamais committer ce fichier.
# Copier vers backend/.env.backup

# --- Source Railway (remplies auto par run_professional_backup.ps1) ---
# MONGO_URL=
# DB_NAME=prevoyancecrm

# --- Chiffrement (OBLIGATOIRE) — phrase longue, hors Railway ---
BACKUP_ENCRYPTION_PASSPHRASE=CHANGEZ_MOI_PHRASE_LONGUE_SECRETE

# Chiffrement applicatif (PII + PDF) — DISTINCT de la passphrase backup
# DATA_ENCRYPTION_PASSPHRASE=CHANGEZ_MOI_AUTRE_PHRASE_LONGUE_SECRETE
# DATA_ENCRYPTION_PASSPHRASE_PREVIOUS=
# AUTO_MIGRATE_ENCRYPTION=true

# --- Object Storage Infomaniak pour copies hors Railway (recommandé) ---
# Bucket privé dédié, ex. prevoyancecrm-backups (région = celle du projet OpenRC)
# IMPORTANT: utiliser pub2 (même endpoint que Horizon), pas pub1.
# Horizon: https://s3.pub2.infomaniak.cloud/object/v1/AUTH_<OS_PROJECT_ID>
# Les objets sont sous le préfixe crm-backups/ (dossier virtuel dans Horizon).
# Créer les clés S3: openstack ec2 credentials create
#   (ou: python deploy/infomaniak/create_backup_s3_keys.py)
BACKUP_S3_ENDPOINT_URL=https://s3.pub2.infomaniak.cloud
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=prevoyancecrm-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_PREFIX=crm-backups/

# Stricte: echouer si un fichier ACTIF manque (soft-deleted orphelins ignores)
BACKUP_STRICT=true
BACKUP_MAX_FAIL_RATIO=0
BACKUP_KEEP_PLAIN_TAR=false
# Apres chiffrement, supprimer le dossier clair backups_full_* (Mongo+PDF)
BACKUP_KEEP_PLAIN_DIR=false

# Dossier local des backups (independant de Railway)
# BACKUP_DIR=
# 7 archives .crmbak les plus recentes sur Infomaniak (et local par defaut)
BACKUP_RETENTION_COUNT=7
# BACKUP_RETENTION_REMOTE=7
# BACKUP_RETENTION_LOCAL=7

# Exiger un upload Infomaniak vérifié pour succès (true recommandé)
BACKUP_REQUIRE_REMOTE=true

# Optionnel: mot de passe Windows du compte de la tâche
# (mode "Run whether user is logged on or not" avec accès réseau complet)
# BACKUP_TASK_PASSWORD=
