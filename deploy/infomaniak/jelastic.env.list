# Variables d'environnement à définir dans Jelastic (Docker) pour le CRM.
# Ne pas y mettre MONGO_URL une fois PostgreSQL + S3 actifs.

PORT=8000
DATABASE_URL=
S3_ENDPOINT_URL=https://s3.pub1.infomaniak.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=prevoyance-crm-docs
S3_REGION=dc3-a
S3_FORCE_PATH_STYLE=true
CORS_ORIGINS=*
PUBLIC_APP_URL=
DB_NAME=prevoyancecrm
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# RAPPEL_EMAIL_GRACE_MINUTES=120

# Healthcheck suggéré Jelastic:
# GET /health  →  {"status":"ok"}
# Conteneur écoute 0.0.0.0:${PORT}
