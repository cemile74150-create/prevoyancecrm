# Architecture economique (Railway + Mongo). Pas de Postgres/Jelastic.
# Copier les valeurs S3/SMTP dans Railway Variables (jamais committer de secrets).

# --- Mongo (deja sur Railway) ---
# MONGO_URL=...
# DB_NAME=prevoyancecrm

# --- Stockage fichiers (optionnel S3 Infomaniak prive) ---
# S3_ENDPOINT_URL=https://s3.pub1.infomaniak.cloud
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=prevoyance-crm-docs
# S3_REGION=dc3-a
# S3_FORCE_PATH_STYLE=true

# Interdit le repli disque ephemere en prod (defaut auto sur Railway)
ALLOW_LOCAL_STORAGE=false

# --- Chiffrement applicatif PII + documents (OBLIGATOIRE en prod) ---
# Distinct de BACKUP_ENCRYPTION_PASSPHRASE. Phrase longue hors repo / coffre.
# DATA_ENCRYPTION_PASSPHRASE=changez-moi-phrase-longue-securisee
# Ou clé brute 32 octets en base64 :
# DATA_ENCRYPTION_KEY=
# Rotation : garder l'ancienne en *_PREVIOUS le temps de la re-migration
# DATA_ENCRYPTION_PASSPHRASE_PREVIOUS=
# DATA_ENCRYPTION_KEY_PREVIOUS=
# AUTO_MIGRATE_ENCRYPTION=true

# --- E-mail CRM via SMTP Infomaniak (pas de Resend) ---
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=noreply@leosoft.ch
# SMTP_PASSWORD=  ← secret Railway uniquement, jamais dans Git
SMTP_FROM=noreply@leosoft.ch
SMTP_FROM_NAME=LeoSoft
SMTP_REPLY_TO=noreply@leosoft.ch
PUBLIC_APP_URL=https://app.leosoft.ch
OFFRES_EMAIL_TO=offres@agencemendes.ch
OFFICE_EMAIL_TO=office@agencemendes.ch
# OFFRES_EMAIL_ENABLED=
RAPPEL_EMAIL_GRACE_MINUTES=120

RAILWAY_APP_URL=https://prevoyance-frontend-production.up.railway.app
